#!/usr/bin/env bash

# Ensure wildcards in globs match dotfiles too.
shopt -s dotglob

indent() {
    sed -u 's/^/      /'
}

BUILD_DIR="$1"
CACHE_DIR="$2"
ENV_DIR="$3"
STAGE="$(mktemp -d)"
EXTRA_STAGE="$(mktemp -d)"

if [ ! -f "${ENV_DIR}/APP_BASE" ]; then
    echo "APP_BASE was not set. Aborting" | indent
    exit 1
fi
APP_BASE="$(cat "${ENV_DIR}/APP_BASE")"
# Optional space-separated repo paths to keep alongside APP_BASE.
APP_EXTRA_PATHS="$(cat "${ENV_DIR}/APP_EXTRA_PATHS" 2>/dev/null)"

(
    for path in $APP_EXTRA_PATHS; do
        mkdir -p "${EXTRA_STAGE}/$(dirname "$path")" &&
        mv "${BUILD_DIR}/${path}" "${EXTRA_STAGE}/${path}" || exit 1
    done
    mv "${BUILD_DIR}/${APP_BASE}" "${STAGE}" &&
    rm -rf "${BUILD_DIR}"/* &&
    mv "${STAGE}/$(basename "$APP_BASE")"/* "${BUILD_DIR}" &&
    { [ -z "$APP_EXTRA_PATHS" ] || mv "${EXTRA_STAGE}"/* "${BUILD_DIR}"; }
)

if [ $? -ne 0 ]; then
    echo "FAILED to copy directory into place" | indent
    exit 1
fi

echo "Copied ${APP_BASE} ${APP_EXTRA_PATHS} to root of app successfully" | indent

